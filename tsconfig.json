{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": [
      "esnext"
    ],
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "moduleResolution": "bundler", 
    "customConditions": ["react-native"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "jest",
    "e2e"
  ]
}